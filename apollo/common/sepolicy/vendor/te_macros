#####################################
# gpu_access(client_domain)
# Allow client_domain to access the GPU device nodes
# This covers /dev/dri/card* and /dev/dri/renderD* (gpu_device label)
# and sysfs GPU attributes (sysfs_gpu label).
define(`gpu_access', `
allow $1 gpu_device:dir r_dir_perms;
allow $1 gpu_device:chr_file rw_file_perms;
allow $1 sysfs_gpu:dir r_dir_perms;
allow $1 sysfs_gpu:file r_file_perms;
')
