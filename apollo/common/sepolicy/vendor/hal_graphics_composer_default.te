# drm_hwcomposer needs GPU access for atomic KMS commits and cursor planes
gpu_access(hal_graphics_composer_default)

# drm_hwcomposer uses vndbinder for AIDL HAL interface
vndbinder_use(hal_graphics_composer_default)

# Allow uevent socket for HDMI hotplug detection
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read };

