# gpu_access macro grants chr_file rw on gpu_device + renderD* nodes
gpu_access(hal_graphics_allocator_default)

# Additional access needed by minigbm
allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default graphics_device:dir r_dir_perms;
allow hal_graphics_allocator_default ion_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_default self:capability sys_nice;

